DJANGO_SECRET_KEY=replace-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=ays_connect
POSTGRES_USER=ays
POSTGRES_PASSWORD=ays_dev_password
DATABASE_URL=postgresql://ays:ays_dev_password@db:5432/ays_connect
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000
KNOWLEDGE_MAX_FILE_SIZE_MB=50

# iiko Cloud: backend only. Use a separate local file per connection or process environment.
IIKO_CONNECTION_ID=sheregesh
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
IIKO_API_KEY=
IIKO_BASE_URL=https://api-ru.iiko.services
IIKO_CONNECT_TIMEOUT=5
IIKO_READ_TIMEOUT=20
IIKO_MAX_RETRIES=2
# Web card check: server-side path to a separate credentials file (or use process IIKO_* variables).
IIKO_SHEREGESH_ENV_FILE=
IIKO_SHEREGESH_ORGANIZATION_ID=07727ae8-4b93-4529-ac85-9232fae45be3

# Production alias of the safe template. No real values belong here.
DJANGO_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_VALUE
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=work.example.com,backend
PRODUCTION_HOST=work.example.com
CSRF_TRUSTED_ORIGINS=https://work.example.com
CORS_ALLOWED_ORIGINS=https://work.example.com
POSTGRES_DB=ays_connect
POSTGRES_USER=ays_connect
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE
AYS_CONNECT_PUBLIC_URL=https://work.example.com
AYS_CONNECT_VERSION=1.0.0-rc1
DJANGO_SECURE_HSTS_SECONDS=31536000
BACKUP_RETENTION_DAYS=7
NOTIFICATIONS_TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://work.example.com/api/integrations/telegram/webhook/
NOTIFICATIONS_EMAIL_ENABLED=0
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=AYS Connect <no-reply@example.com>

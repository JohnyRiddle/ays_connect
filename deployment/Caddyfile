http://{$PILOT_HOST} {
    redir https://{$PILOT_HOST}{uri} permanent
}

https://{$PILOT_HOST} {
    tls internal
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}

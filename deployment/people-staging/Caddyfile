:80 {
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host localhost
        }
    }
    handle /media/* {
        respond 404
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
